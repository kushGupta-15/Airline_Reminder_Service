# Airline Reminder Service Environment Configuration

# Server Port
PORT=3004

# Email Credentials (Nodemailer Gmail SMTP)
# Note: For Gmail, generate a 16-character "App Password" at https://myaccount.google.com/apppasswords
EMAIL_ID=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# RabbitMQ Message Broker Configuration
MESSAGE_BROKER_URL=amqp://localhost:5672
EXCHANGE_NAME=AIRLINE_BUS
REMINDER_BINDING_KEY=REMINDER_SERVICE

# Node Environment
NODE_ENV=development
